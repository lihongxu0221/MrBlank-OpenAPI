LINUXDO_CLIENT_ID=your_client_id
LINUXDO_CLIENT_SECRET=your_client_secret
LINUXDO_REDIRECT_URI=https://your-domain.example/oauth/linuxdo
PORT=8787
SESSION_SECRET=generate_a_long_random_string
HOST=127.0.0.1
SITE_ORIGIN=https://your-domain.example

# CPA kernel (primary). Prefer *_FILE paths; never commit real secrets.
CPA_BASE_URL=http://127.0.0.1:8317
CPA_BILLING_URL=http://127.0.0.1:8320
PUBLIC_API_BASE_URL=https://your-domain.example/v1
CPA_DEMO_API_KEY_FILE=/path/to/secrets/demo-client-api-key
CPA_MANAGEMENT_KEY_FILE=/path/to/secrets/cpa-management-key
# Dedicated upstream key the BFF uses for every /v1 call to CPA (required for /v1).
# Site keys (sk-mrblank-*) are NOT registered in CPA; only the BFF authenticates them.
CPA_UPSTREAM_API_KEY_FILE=/path/to/secrets/bff-upstream-key
# Max concurrent consuming /v1 requests per user (default 4)
# V1_USER_MAX_INFLIGHT=4
# Serve ../dist from Express (index.html no-cache, /assets immutable). Set 0 to disable.
# SERVE_DIST=1
# Default: server/data/user-keys.json
# USER_KEYS_PATH=./server/data/user-keys.json
# Site-only usage log (leaderboard / activity / admin usage). Default: server/data/site-usage.json
# SITE_USAGE_PATH=

# CPAMP (DEPRECATED — optional). Not required for pool/accounts/config/keys/usage.
# CPAMP_BASE_URL=http://127.0.0.1:18317
# CPAMP_ADMIN_KEY_FILE=/path/to/secrets/cpamp-admin-key

# Admin console allowlist (Linux.do). Only the numeric Linux.do id or the OAuth email
# field are honoured. Comma/space separated.
ADMIN_LINUXDO_IDS=
ADMIN_LINUXDO_EMAILS=
# ADMIN_LINUXDO_USERNAMES is IGNORED for admin decisions (usernames/display names are mutable).

# Local users are admin ONLY via role=admin. This list is used solely to seed role=admin
# on first bootstrap when no local admin exists yet.
ADMIN_LOCAL_USERNAMES=
# Legacy alias (bootstrap-only as well):
# ADMIN_AILY_USERNAMES=

# Bootstrap first local admin (only creates if username missing; never commit real password)
BOOTSTRAP_ADMIN_USER=
BOOTSTRAP_ADMIN_PASSWORD=
LOCAL_USERS_PATH=

# User groups JSON (quotas / model allowlists / promotion)
USER_GROUPS_PATH=

# Aily upstream — embedded in BFF (NOT site login). Separate :8088 adapter is optional/legacy.
# Shared auth file (access/refresh tokens)
# Default: <home dir>/.config/aily-project/.aily
# AILY_AUTH_FILE=/path/to/.config/aily-project/.aily
# AILY_ADMIN_CONFIG_FILE=/path/to/.config/aily-project/admin.json
# Force upstream base (otherwise region select / Token region / admin.json)
# AILY_BASE_URL=https://api.yiyu.pro
# Selective routing: comma patterns (exact or prefix*) → in-process Aily bridge instead of CPA
# Optional bare-id override to embedded Aily (plaza still lists aily/{id}).
# Prefer calling aily/glm-5.3; bare glm-5.3 defaults to CPA unless listed here.
# AILY_MODEL_ROUTES=aily-*,glm-5.3
# Multi-Aily account pool (NOT grok/openai aily-accounts.json)
# AILY_CREDENTIALS_PATH=server/data/aily-credentials.json
# Load balance when /v1 routes to Aily: round-robin (default) | priority
# AILY_LOAD_BALANCE_STRATEGY=round-robin
# Auto-refresh interval for pool accounts near JWT expiry (ms)
# AILY_POOL_REFRESH_INTERVAL_MS=600000
# Legacy (unused for happy path; kept for compatibility):
# AILY_ADAPTER_URL=
# AILY_ADAPTER_API_KEY=
# AILY_ADAPTER_API_KEY_FILE=
# AILY_ADAPTER_ADMIN_USER=
# AILY_ADAPTER_ADMIN_PASSWORD=


# Phase C — request diagnosis (BFF /v1 capture)
V1_PROXY_ENABLED=1
DIAGNOSIS_PATH=
DIAGNOSIS_MAX_BODY_CHARS=524288
DIAGNOSIS_MAX_INDEX=800

# Phase F — site credits / check-in / redeem (persisted JSON)
SITE_CREDITS_PATH=

# Model price book (JSON file store) — in/out/cache USD per MTok
# MODEL_PRICES_PATH=
# Scheduled official sync (models.dev → LiteLLM → OpenRouter). Default interval 24h.
# Set MODEL_PRICES_SYNC_INTERVAL_HOURS=0 to disable. MODEL_PRICES_SYNC_CRON accepts "24" or "every 24h".
# MODEL_PRICES_SYNC_INTERVAL_HOURS=24
# MODEL_PRICES_SYNC_CRON=24
# MODEL_PRICES_SYNC_ON_BOOT=1
