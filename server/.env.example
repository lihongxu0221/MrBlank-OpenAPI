LINUXDO_CLIENT_ID=your_client_id
LINUXDO_CLIENT_SECRET=your_client_secret
LINUXDO_REDIRECT_URI=https://openapi.juc114.cn/oauth/linuxdo
PORT=8787
SESSION_SECRET=generate_a_long_random_string
HOST=127.0.0.1
SITE_ORIGIN=https://openapi.juc114.cn

# CPA kernel (primary). Prefer *_FILE paths; never commit real secrets.
CPA_BASE_URL=http://127.0.0.1:8317
CPA_BILLING_URL=http://127.0.0.1:8320
PUBLIC_API_BASE_URL=https://openapi.juc114.cn/v1
CPA_DEMO_API_KEY_FILE=/home/ubuntu/cpa-manager-plus/secrets/demo-client-api-key
CPA_MANAGEMENT_KEY_FILE=/home/ubuntu/cpa-manager-plus/secrets/cpa-management-key
USER_KEYS_PATH=/home/ubuntu/sites/MrBlank-OpenAPI/server/data/user-keys.json
# Site-only usage log (leaderboard / activity / admin usage). Default: server/data/site-usage.json
# SITE_USAGE_PATH=

# CPAMP (DEPRECATED — optional). Not required for pool/accounts/config/keys/usage.
# CPAMP_BASE_URL=http://127.0.0.1:18317
# CPAMP_ADMIN_KEY_FILE=/home/ubuntu/cpa-manager-plus/secrets/cpamp-admin-key

# Admin console allowlist (Linux.do). If both empty, nobody is admin via OAuth alone.
# Comma/space separated. IDs are preferred; usernames are case-insensitive.
ADMIN_LINUXDO_IDS=
ADMIN_LINUXDO_USERNAMES=
ADMIN_LINUXDO_EMAILS=

# Local username allowlist (optional; local users with role=admin are already admins)
ADMIN_LOCAL_USERNAMES=
# Legacy alias (still read):
# ADMIN_AILY_USERNAMES=

# Bootstrap first local admin (only creates if username missing; never commit real password)
BOOTSTRAP_ADMIN_USER=
BOOTSTRAP_ADMIN_PASSWORD=
LOCAL_USERS_PATH=

# User groups JSON (quotas / model allowlists / promotion)
USER_GROUPS_PATH=

# Aily upstream — embedded in BFF (NOT site login). Separate :8088 adapter is optional/legacy.
# Shared auth file (access/refresh tokens)
# AILY_AUTH_FILE=/home/ubuntu/.config/aily-project/.aily
# AILY_ADMIN_CONFIG_FILE=/home/ubuntu/.config/aily-project/admin.json
# Force upstream base (otherwise region select / Token region / admin.json)
# AILY_BASE_URL=https://api.yiyu.pro
# Selective routing: comma patterns (exact or prefix*) → in-process Aily bridge instead of CPA
# Optional bare-id override to embedded Aily (plaza still lists aily/{id}).
# Prefer calling aily/glm-5.3; bare glm-5.3 defaults to CPA unless listed here.
# AILY_MODEL_ROUTES=aily-*,glm-5.3
# Legacy (unused for happy path; kept for compatibility):
# AILY_ADAPTER_URL=
# AILY_ADAPTER_API_KEY=
# AILY_ADAPTER_API_KEY_FILE=
# AILY_ADAPTER_ADMIN_USER=
# AILY_ADAPTER_ADMIN_PASSWORD=


# Phase C — request diagnosis (BFF /v1 capture)
V1_PROXY_ENABLED=1
DIAGNOSIS_PATH=
DIAGNOSIS_MAX_BODY_CHARS=524288
DIAGNOSIS_MAX_INDEX=800

# Phase F — site credits / check-in / redeem (persisted JSON)
SITE_CREDITS_PATH=
